cluster_name          = "my-talos-cluster"
region                = "us-east-1"
vpc_id                = "vpc-xxxxxxxxxxxxxxxxx"
external_source_cidrs = ["0.0.0.0/0"]

talos_version = "v1.12.1"

controlplane_count = 2
workers_count      = 2

control_plane = {
  instance_type = "t3.large"
}

worker_groups = [
  {
    name          = "default"
    instance_type = "t3.large"
  }
]

pod_cidr     = "100.64.0.0/14"
service_cidr = "100.68.0.0/16"

disable_kube_proxy = true

root_volume_size = 150

enable_external_cloud_provider              = true
deploy_external_cloud_provider_iam_policies = true

enable_cilium            = true
cilium_helm_version      = "1.17.4"
cilium_helm_values_file_path = "cilium-values.yaml"
